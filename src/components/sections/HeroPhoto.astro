---
import { Picture } from 'astro:assets';
import type { Photo } from '../../data/photos';
import UnderlineLink from '../ui/UnderlineLink.astro';

interface Props {
	photo: Photo;
	word?: string;
}

const { photo, word = 'AUSTRAL' } = Astro.props;
---

<section class="relative isolate flex min-h-svh flex-col justify-between overflow-hidden text-on-photo" data-hero>
	<Picture
		src={photo.src}
		alt={photo.alt}
		formats={['avif', 'webp']}
		widths={[800, 1400, 2000, 2400]}
		sizes="100vw"
		loading="eager"
		fetchpriority="high"
		pictureAttributes={{ class: 'absolute inset-0 -z-10' }}
		class="hero-photo size-full object-cover"
	/>
	<!-- Velos: solo para que se lea el texto sobre la foto. -->
	<div class="absolute inset-x-0 top-0 -z-10 h-2/5 bg-linear-to-b from-ink/40 to-transparent"></div>
	<div class="absolute inset-x-0 bottom-0 -z-10 h-1/2 bg-linear-to-t from-ink/45 to-transparent"></div>

	<div class="enter flex justify-end px-(--gutter) pt-28 md:pt-32">
		<!-- Recuadro hueso con tinta: el contraste no depende de la foto que haya detrás. -->
		<div class="max-w-[32ch] bg-ground p-5 text-ink">
			<p class="text-lead">Ropa de abrigo para el clima del sur: lana, franela y algodón encerado, en tiradas cortas.</p>
			<UnderlineLink href="#tienda" class="mt-4 text-button-md font-stretch-110% uppercase">Ver colección →</UnderlineLink>
		</div>
	</div>

	<!-- El tamaño usa cqw: se calcula sobre el ancho real del contenedor, sin contar la barra de scroll. -->
	<div class="enter px-(--gutter) pb-6">
		<div class="@container">
			<h1 class="text-wordmark font-stretch-expanded whitespace-nowrap">{word}</h1>
		</div>
	</div>
</section>
