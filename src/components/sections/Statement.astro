---
interface Props {
	lines: [string, string];
	mark?: string;
}

const { lines, mark = '©26' } = Astro.props;
---

<section class="px-(--gutter) pt-section">
	<div class="h-[2px] bg-ink"></div>
	<div class="mt-6 flex flex-col justify-between gap-8 text-display text-ink md:flex-row md:items-start">
		<h2>{lines[0]}<br />{lines[1]}</h2>
		<p aria-hidden="true">{mark}</p>
	</div>
	<p class="mt-section max-w-3xl text-lead text-ink">
		<slot />
	</p>
</section>
