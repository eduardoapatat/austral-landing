---
import { featured } from '../../data/products';
import Button from '../ui/Button.astro';
import SectionIndex from '../ui/SectionIndex.astro';
import SpecTable from '../ui/SpecTable.astro';

const { name, price, description, specs, colors, band, photos } = featured;
---

<section class="pt-section" aria-labelledby="destacado-title">
	<div class="relative isolate flex h-[60vh] min-h-[420px] items-end overflow-hidden text-on-photo">
		<img
			src={`https://picsum.photos/id/${band}/1600/900`}
			width="1600"
			height="900"
			alt=""
			loading="lazy"
			decoding="async"
			class="absolute inset-0 -z-10 size-full object-cover"
		/>
		<div class="absolute inset-x-0 bottom-0 -z-10 h-2/3 bg-linear-to-t from-ink-mono/45 to-transparent"></div>
		<div class="px-(--gutter) pb-8">
			<p class="text-label font-stretch-110% uppercase">Destacado</p>
			<h2 id="destacado-title" class="mt-3 text-display font-stretch-expanded">{name}</h2>
		</div>
	</div>

	<div class="grid gap-12 px-(--gutter) pt-12 md:grid-cols-2 md:gap-(--gutter)">
		<div class="flex flex-col gap-8">
			<p class="max-w-[36ch] text-lead">{description}</p>
			<SpecTable rows={specs}>
				<div class="flex items-center justify-between gap-6 border-b border-ink/30 py-4">
					<dt class="text-spec-label">Color</dt>
					<dd class="flex gap-2">
						{
							colors.map((color) => (
								<span
									class="size-5 border border-ink"
									style={`background-color: ${color.hex}`}
									title={color.name}
									role="img"
									aria-label={color.name}
								/>
							))
						}
					</dd>
				</div>
			</SpecTable>
			<div class="flex items-center justify-between gap-6">
				<p class="text-headline">{price}</p>
				<Button href="#">Añadir a la bolsa</Button>
			</div>
		</div>
		<div class="grid grid-cols-2 gap-(--gutter) md:grid-cols-1" data-reveal-group>
			{
				photos.map((id) => (
					<div class="aspect-[4/5] overflow-hidden bg-surface-media" data-reveal>
						<img
							src={`https://picsum.photos/id/${id}/800/1000`}
							width="800"
							height="1000"
							alt=""
							loading="lazy"
							decoding="async"
							class="size-full object-cover"
						/>
					</div>
				))
			}
		</div>
	</div>

	<SectionIndex number="04" name="Destacado" class="mx-(--gutter) mt-section" />
</section>
