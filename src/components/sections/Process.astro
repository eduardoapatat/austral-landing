---
import { Picture } from 'astro:assets';
import { photos } from '../../data/photos';
import SectionIndex from '../ui/SectionIndex.astro';

const steps = [
	{ title: 'Lana', text: 'Elegimos lana de oveja de Magallanes y algodón encerado que aguanten el agua y el viento.' },
	{ title: 'Patronaje', text: 'Probamos cada patrón en tres tallas y en terreno, con capas debajo, hasta que abriga sin pesar.' },
	{ title: 'Confección', text: 'Talleres pequeños en Puerto Montt, tiradas cortas y costuras dobles donde más se usa la prenda.', photo: photos['proceso-taller'] },
	{ title: 'Envío', text: 'Embalaje sin plástico y una etiqueta con instrucciones para que dure muchos inviernos.' },
];
---

<section id="proceso" class="scroll-mt-24 px-(--gutter) pt-section" aria-labelledby="proceso-title">
	<h2 id="proceso-title" class="text-display font-stretch-expanded">De la lana<br />al abrigo</h2>

	<div class="mt-16 grid gap-12 md:grid-cols-2 md:gap-(--gutter)">
		<div class="aspect-[4/5] overflow-hidden bg-surface-media md:sticky md:top-24 md:self-start">
			<Picture
				src={photos['proceso-lana'].src}
				alt={photos['proceso-lana'].alt}
				formats={['avif', 'webp']}
				widths={[500, 800, 1200]}
				sizes="(min-width: 768px) 50vw, 100vw"
				class="size-full object-cover"
			/>
		</div>

		<ol class="border-t-2 border-ink" data-reveal-group>
			{
				steps.map((step, i) => (
					<li class="grid grid-cols-[48px_1fr] gap-6 border-b border-ink/30 py-8" data-reveal>
						<span class="grid size-12 place-items-center border-2 border-ink text-headline" aria-hidden="true">
							{i + 1}
						</span>
						<div>
							<h3 class="text-headline">{step.title}</h3>
							<p class="mt-3 max-w-[40ch]">{step.text}</p>
							{step.photo && (
								<div class="mt-6 aspect-[3/2] max-w-md overflow-hidden bg-surface-media">
									<Picture
										src={step.photo.src}
										alt={step.photo.alt}
										formats={['avif', 'webp']}
										widths={[400, 700]}
										sizes="(min-width: 768px) 28rem, 100vw"
										class="size-full object-cover"
									/>
								</div>
							)}
						</div>
					</li>
				))
			}
		</ol>
	</div>

	<SectionIndex number="07" name="Proceso" class="mt-section" />
</section>
