---
import Button from '../ui/Button.astro';
import IconButton from '../ui/IconButton.astro';
import SearchBar from '../ui/SearchBar.astro';

const links = [
	{ href: '#', label: 'Explorar' },
	{ href: '#', label: 'Acerca de' },
	{ href: '#', label: 'Empresas' },
];
---

<header class="sticky top-0 z-50 bg-canvas">
	<nav class="mx-auto flex h-16 max-w-[1280px] items-center gap-4 px-4 md:px-6" aria-label="Principal">
		<details class="group md:hidden">
			<summary class="list-none [&::-webkit-details-marker]:hidden">
				<span
					class="focus-ring inline-flex size-10 cursor-pointer items-center justify-center rounded-full bg-surface-card text-ink"
					aria-label="Menú"
				>
					<svg class="size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" aria-hidden="true">
						<path d="M4 7h16M4 12h16M4 17h16"></path>
					</svg>
				</span>
			</summary>
			<ul class="absolute inset-x-0 top-16 flex flex-col gap-1 border-b border-hairline bg-canvas p-4">
				{
					links.map((link) => (
						<li>
							<a href={link.href} class="focus-ring block rounded-md px-3 py-3 text-body-strong text-ink">
								{link.label}
							</a>
						</li>
					))
				}
				<li>
					<a href="#" class="focus-ring block rounded-md px-3 py-3 text-body-strong text-ink">Iniciar sesión</a>
				</li>
			</ul>
		</details>

		<a href="/" class="focus-ring flex items-center gap-2 rounded-md max-md:mx-auto" aria-label="astro-app, inicio">
			<svg class="size-8 text-primary" viewBox="0 0 32 32" aria-hidden="true">
				<circle cx="16" cy="16" r="16" fill="currentColor"></circle>
				<path d="M11 22 16 9l5 13m-8.2-4.5h6.4" fill="none" stroke="#fff" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"></path>
			</svg>
			<span class="text-heading-md text-primary max-lg:sr-only">astro-app</span>
		</a>

		<ul class="hidden items-center gap-1 md:flex">
			<li>
				<a href={links[0].href} class="focus-ring rounded-md px-3 py-2 text-body-strong text-ink">{links[0].label}</a>
			</li>
		</ul>

		<SearchBar class="hidden flex-1 md:block md:max-w-[480px] lg:mx-auto" />

		<div class="flex items-center gap-1">
			<ul class="hidden items-center gap-1 xl:flex">
				{
					links.slice(1).map((link) => (
						<li>
							<a href={link.href} class="focus-ring rounded-md px-3 py-2 text-body-strong text-ink">
								{link.label}
							</a>
						</li>
					))
				}
			</ul>
			<IconButton class="md:hidden" aria-label="Buscar" aria-expanded="false" aria-controls="mobile-search" data-search-toggle>
				<svg class="size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" aria-hidden="true">
					<circle cx="11" cy="11" r="7"></circle>
					<path d="m20 20-3.5-3.5"></path>
				</svg>
			</IconButton>
			<Button variant="tertiary" href="#" class="max-md:hidden">Iniciar sesión</Button>
			<Button href="#">Regístrate</Button>
		</div>
	</nav>
	<div id="mobile-search" class="hidden px-4 pb-3 md:hidden" data-search-panel>
		<SearchBar />
	</div>
</header>

<script>
	const toggle = document.querySelector<HTMLButtonElement>('[data-search-toggle]');
	const panel = document.querySelector<HTMLElement>('[data-search-panel]');

	toggle?.addEventListener('click', () => {
		const open = panel?.classList.toggle('hidden') === false;
		toggle.setAttribute('aria-expanded', String(open));
		if (open) panel?.querySelector('input')?.focus();
	});
</script>
