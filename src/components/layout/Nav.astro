---
import ThemeSwitcher from '../ui/ThemeSwitcher.astro';
import UnderlineLink from '../ui/UnderlineLink.astro';

const links = [
	{ href: '#', label: 'Tienda', active: true },
	{ href: '#', label: 'Bolsa (0)' },
];
---

<!-- La barra se mezcla con difference para invertirse sobre las fotos; el panel del menú va fuera para no mezclarse. -->
<header
	class="enter pointer-events-none fixed inset-x-0 top-0 z-40 mix-blend-difference"
	style="color: var(--nav-ink)"
>
	<nav class="flex items-center justify-between px-(--gutter) py-6 md:py-8 lg:pr-36" aria-label="Principal">
		<a href="/" class="pointer-events-auto" aria-label="ASTRO, inicio">
			<svg class="h-6 w-12" viewBox="0 0 48 24" fill="currentColor" aria-hidden="true">
				<rect width="24" height="24"></rect>
				<circle cx="36" cy="12" r="12"></circle>
			</svg>
		</a>
		<ul class="pointer-events-auto flex items-center gap-6 text-product-title md:gap-16 md:text-nav-link">
			{
				links.map((link, i) => (
					<li class:list={[i === 0 && 'max-md:hidden']}>
						<UnderlineLink href={link.href} active={link.active}>
							{link.label}
						</UnderlineLink>
					</li>
				))
			}
			<li class="lg:hidden">
				<button type="button" aria-expanded="false" aria-controls="site-menu" data-menu-toggle>Menú</button>
			</li>
		</ul>
	</nav>
</header>

<!-- Los puntos de tema van fuera de la barra: con difference cambiarían de color. -->
<ThemeSwitcher class="enter fixed top-7 right-(--gutter) z-40 max-lg:hidden" />

<div id="site-menu" class="fixed inset-0 z-30 hidden flex-col bg-ground px-(--gutter) pt-28 lg:hidden" data-menu>
	<ul class="flex flex-col gap-2 text-display text-ink">
		{
			links.map((link) => (
				<li>
					<a href={link.href}>{link.label}</a>
				</li>
			))
		}
	</ul>
	<ThemeSwitcher class="mt-12 -ml-1.5" />
</div>

<script>
	const toggle = document.querySelector<HTMLButtonElement>('[data-menu-toggle]');
	const menu = document.querySelector<HTMLElement>('[data-menu]');

	const setOpen = (open: boolean) => {
		menu?.classList.toggle('hidden', !open);
		menu?.classList.toggle('flex', open);
		toggle?.setAttribute('aria-expanded', String(open));
		if (toggle) toggle.textContent = open ? 'Cerrar' : 'Menú';
	};

	toggle?.addEventListener('click', () => setOpen(menu?.classList.contains('hidden') ?? false));
	document.addEventListener('keydown', (event) => {
		if (event.key === 'Escape') setOpen(false);
	});
</script>
