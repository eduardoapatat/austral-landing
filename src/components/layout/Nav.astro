---
import UnderlineLink from '../ui/UnderlineLink.astro';

interface Props {
	/** La página empieza con un hero a sangre: el header es transparente hasta salir de él. */
	overHero?: boolean;
}

const { overHero = false } = Astro.props;

/** Secciones de la página; el nav marca la que está a la vista (ver script). */
const sections = [
	{ href: '/#tienda', label: 'Tienda' },
	{ href: '/#rutas', label: 'Rutas' },
	{ href: '/#proceso', label: 'Proceso' },
	{ href: '/#contacto', label: 'Contacto' },
];
---

<!-- Transparente sobre el hero; con data-solid pasa al fondo de la página (ver script). -->
<header
	class="fixed inset-x-0 top-0 z-40 border-b border-transparent text-on-photo transition-[background-color,color,border-color] duration-300 ease-standard data-solid:border-ink/15 data-solid:bg-ground data-solid:text-ink"
	data-solid={overHero ? undefined : ''}
	data-header
>
	<nav class="flex items-center justify-between px-(--gutter) py-6 md:py-8" aria-label="Principal">
		<a href="/" aria-label="AUSTRAL, inicio">
			<svg class="h-6 w-[38px]" viewBox="0 0 38 24" fill="currentColor" aria-hidden="true">
				<rect width="24" height="24"></rect>
				<rect x="30" width="8" height="24"></rect>
			</svg>
		</a>
		<ul class="flex items-center gap-6 text-product-title md:gap-10 md:text-nav-link lg:gap-16">
			{sections.slice(0, 3).map((link) => (
				<li class="max-md:hidden">
					<UnderlineLink href={link.href} data-spy={link.href.split('#')[1]}>
						{link.label}
					</UnderlineLink>
				</li>
			))}
			<li>
				<span aria-label="Bolsa">
					Bolsa (<span data-bag-count>0</span>)
				</span>
			</li>
			<li class="md:hidden">
				<button
					type="button"
					class="underline-offset-4 hover:underline"
					aria-expanded="false"
					aria-controls="site-menu"
					data-menu-toggle
				>
					Menú
				</button>
			</li>
		</ul>
	</nav>
</header>

<div
	id="site-menu"
	class="fixed inset-0 z-30 hidden flex-col overflow-y-auto overscroll-contain bg-ground px-(--gutter) pt-28 md:hidden"
	data-menu
>
	<ul class="flex flex-col gap-2 text-display font-stretch-expanded text-ink max-md:text-[10vw]">
		{sections.map((link) => (
			<li>
				<a href={link.href} data-menu-link>
					{link.label}
				</a>
			</li>
		))}
	</ul>
</div>

<!-- Anuncio para lectores de pantalla cuando se añade algo a la bolsa. -->
<p class="sr-only" aria-live="polite" data-bag-status></p>

{/* La CSP de vercel.json admite este script por su hash: si cambia, recalcularlo (ver AGENTS.md). */}
<script>
	const header = document.querySelector<HTMLElement>('[data-header]');
	const hero = document.querySelector<HTMLElement>('[data-hero]');
	const toggle = document.querySelector<HTMLButtonElement>('[data-menu-toggle]');
	const menu = document.querySelector<HTMLElement>('[data-menu]');

	let pastHero = !hero;
	let menuOpen = false;

	const syncHeader = () => header?.toggleAttribute('data-solid', pastHero || menuOpen);

	// El hero deja de "estar bajo el header" cuando su borde inferior sube por encima de la base del header.
	if (hero && header) {
		new IntersectionObserver(
			([entry]) => {
				pastHero = !entry.isIntersecting;
				syncHeader();
			},
			{ rootMargin: `-${header.offsetHeight}px 0px 0px 0px` },
		).observe(hero);
	}

	const setOpen = (open: boolean) => {
		menuOpen = open;
		menu?.classList.toggle('hidden', !open);
		menu?.classList.toggle('flex', open);
		toggle?.setAttribute('aria-expanded', String(open));
		if (toggle) toggle.textContent = open ? 'Cerrar' : 'Menú';
		// Con el menú abierto la página de fondo no se desplaza ni recibe foco.
		document.documentElement.style.overflow = open ? 'hidden' : '';
		if (open) window.lenis?.stop();
		else window.lenis?.start();
		document.querySelectorAll<HTMLElement>('main, footer').forEach((el) => (el.inert = open));
		if (open) menu?.querySelector<HTMLElement>('[data-menu-link]')?.focus();
		syncHeader();
	};

	toggle?.addEventListener('click', () => setOpen(!menuOpen));
	document.querySelectorAll('[data-menu-link]').forEach((link) => link.addEventListener('click', () => setOpen(false)));

	// Marca en el nav la sección que ocupa el centro de la pantalla.
	const spies = [...document.querySelectorAll<HTMLElement>('[data-spy]')];
	const spyObserver = new IntersectionObserver(
		(entries) => {
			for (const entry of entries) {
				if (!entry.isIntersecting) continue;
				spies.forEach((link) =>
					link.dataset.spy === entry.target.id
						? link.setAttribute('aria-current', 'location')
						: link.removeAttribute('aria-current'),
				);
			}
		},
		{ rootMargin: '-45% 0px -50% 0px' },
	);
	spies.forEach((link) => {
		const section = link.dataset.spy && document.getElementById(link.dataset.spy);
		if (section) spyObserver.observe(section);
	});

	// Bolsa: contador simple guardado en el navegador (no hay checkout todavía).
	const BAG_KEY = 'austral-bag';
	const readBag = () => {
		try {
			return Number(localStorage.getItem(BAG_KEY)) || 0;
		} catch {
			return 0;
		}
	};
	let bag = readBag();
	const renderBag = () => document.querySelectorAll('[data-bag-count]').forEach((el) => (el.textContent = String(bag)));
	renderBag();

	document.addEventListener('click', (event) => {
		const button =
			event.target instanceof Element ? event.target.closest<HTMLButtonElement>('[data-add-to-bag]') : null;
		if (!button) return;
		bag += 1;
		try {
			localStorage.setItem(BAG_KEY, String(bag));
		} catch {
			// Sin almacenamiento (modo privado): el contador solo dura esta visita.
		}
		renderBag();
		const status = document.querySelector('[data-bag-status]');
		if (status)
			status.textContent = `${button.dataset.addToBag} añadida a la bolsa. Tienes ${bag} ${bag === 1 ? 'pieza' : 'piezas'}.`;
		// El texto original se guarda una sola vez: con dos clics seguidos no se queda en "Añadida ✓".
		const label = (button.dataset.label ??= button.textContent ?? '');
		button.textContent = 'Añadida ✓';
		clearTimeout(Number(button.dataset.timer));
		button.dataset.timer = String(setTimeout(() => (button.textContent = label), 1800));
	});
	document.addEventListener('keydown', (event) => {
		if (event.key !== 'Escape' || !menuOpen) return;
		setOpen(false);
		toggle?.focus();
	});
</script>
