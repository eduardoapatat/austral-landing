---
import UnderlineLink from '../ui/UnderlineLink.astro';

const columns = [
	['Instagram', 'LinkedIn', 'Behance'],
	['Trabajo', 'Servicios', 'Nosotros'],
	['Hablemos'],
];
---

<footer class="px-(--gutter) pt-8 pb-16">
	<div class="h-px bg-ink opacity-50"></div>
	<div class="mt-8 grid grid-cols-3 gap-x-(--gutter) gap-y-12 text-spec-label lg:grid-cols-8">
		<div class="col-span-3 lg:col-span-2">
			<p class="text-lead leading-none font-bold tracking-tight text-ink">ASTRO</p>
			<p class="mt-1">Todos los derechos reservados © 2026</p>
		</div>
		<address class="col-span-2 not-italic lg:col-span-2">
			Av. Ejemplo 123<br />Oficina 4<br />Lima, Perú
		</address>
		<UnderlineLink href="#" class="self-start justify-self-start lg:col-span-1">Privacidad</UnderlineLink>
		{
			columns.map((links) => (
				<ul class="flex flex-col gap-3 max-lg:row-start-2 lg:col-span-1">
					{links.map((link) => (
						<li>
							<UnderlineLink href="#">{link}</UnderlineLink>
						</li>
					))}
				</ul>
			))
		}
	</div>
</footer>
