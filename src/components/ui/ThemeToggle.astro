---
interface Props {
	class?: string;
}

const { class: className } = Astro.props;

const themes = [
	{ id: 'cobalt', label: 'Cobalto' },
	{ id: 'mono', label: 'Tinta' },
	{ id: 'night', label: 'Noche' },
];
---

<div
	class:list={['flex items-center gap-2 text-label font-stretch-110% uppercase', className]}
	role="group"
	aria-label="Tema de color"
>
	{
		themes.map((theme, i) => (
			<>
				{i > 0 && <span aria-hidden="true">·</span>}
				<button
					type="button"
					class="py-2 decoration-2 underline-offset-4 aria-pressed:underline"
					aria-pressed="false"
					data-theme-option={theme.id}
				>
					{theme.label}
				</button>
			</>
		))
	}
</div>

<script>
	const KEY = 'astro-theme';
	const buttons = document.querySelectorAll<HTMLButtonElement>('[data-theme-option]');

	const sync = () => {
		const current = document.documentElement.dataset.theme;
		buttons.forEach((button) => button.setAttribute('aria-pressed', String(button.dataset.themeOption === current)));
	};

	buttons.forEach((button) =>
		button.addEventListener('click', () => {
			const theme = button.dataset.themeOption ?? 'cobalt';
			document.documentElement.dataset.theme = theme;
			try {
				localStorage.setItem(KEY, theme);
			} catch {
				// Sin almacenamiento (modo privado): el tema solo dura esta visita.
			}
			sync();
		}),
	);

	sync();
</script>
