---
import type { HTMLAttributes } from 'astro/types';
import UnderlineLink from './UnderlineLink.astro';

type Props = HTMLAttributes<'a'> & {
	variant?: 'primary' | 'text';
	href: string;
};

const { variant = 'primary', href, class: className, ...rest } = Astro.props;
---

{
	variant === 'primary' ? (
		<a
			href={href}
			class:list={[
				'inline-flex h-12 items-center justify-center bg-primary-ink px-6 text-button-md text-on-primary uppercase',
				className,
			]}
			{...rest}
		>
			<slot />
		</a>
	) : (
		<UnderlineLink href={href} class:list={['text-button-md uppercase', className]} {...rest}>
			<slot />
		</UnderlineLink>
	)
}
