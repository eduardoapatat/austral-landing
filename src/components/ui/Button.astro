---
import type { HTMLAttributes } from 'astro/types';

type Props = HTMLAttributes<'button'> & {
	variant?: 'primary' | 'secondary' | 'tertiary';
	href?: string;
};

const { variant = 'primary', href, disabled, class: className, ...rest } = Astro.props;

const variants = {
	primary: 'bg-primary text-on-primary active:bg-primary-pressed',
	secondary: 'bg-secondary-bg text-on-secondary active:bg-secondary-pressed',
	tertiary: 'bg-transparent text-ink',
};

const classes = [
	'focus-ring inline-flex h-10 items-center justify-center gap-1 rounded-md px-3.5 text-button-md whitespace-nowrap',
	disabled ? 'cursor-not-allowed bg-surface-card text-ash' : variants[variant],
	className,
];
---

{
	href && !disabled ? (
		<a href={href} class:list={classes}>
			<slot />
		</a>
	) : (
		<button type="button" disabled={disabled} class:list={classes} {...rest}>
			<slot />
		</button>
	)
}
