---
interface Props {
	placeholder?: string;
	value?: string;
	class?: string;
}

const { placeholder = 'Busca ideas, moda, recetas…', value, class: className } = Astro.props;
---

<form role="search" action="/" class:list={['relative', className]}>
	<svg
		class="pointer-events-none absolute top-1/2 left-4 size-4 -translate-y-1/2 text-mute"
		viewBox="0 0 24 24"
		fill="none"
		stroke="currentColor"
		stroke-width="2.5"
		stroke-linecap="round"
		aria-hidden="true"
	>
		<circle cx="11" cy="11" r="7"></circle>
		<path d="m20 20-3.5-3.5"></path>
	</svg>
	<input
		type="search"
		name="q"
		aria-label="Buscar"
		placeholder={placeholder}
		value={value}
		class="h-12 w-full rounded-full border border-transparent bg-surface-card py-[11px] pr-[15px] pl-11 text-body-md text-ink outline-none placeholder:text-ash focus:border-ash focus:bg-canvas"
	/>
</form>
