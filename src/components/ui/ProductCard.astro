---
import { photoUrl, SIZES, type Product } from '../../data/products';
import ProductTag from './ProductTag.astro';

interface Props {
	product: Product;
	wide?: boolean;
	href?: string;
	class?: string;
}

const { product, wide = false, href = '#', class: className } = Astro.props;
const { title, price, category, ratio, photo, altPhoto, soldOut } = product;

const aspect = {
	'2/3': 'aspect-[2/3]',
	'3/4': 'aspect-[3/4]',
	'1/1': 'aspect-square',
	'4/5': 'aspect-[4/5]',
}[ratio];

const scale = wide ? 1.25 : 1;
const main = photoUrl(photo, ratio, scale);
const alt = photoUrl(altPhoto, ratio, scale);
const available = SIZES.filter((size) => !soldOut.includes(size));
---

<a href={href} class:list={['group block', className]} data-reveal>
	<div class:list={['relative overflow-hidden bg-surface-media', aspect]}>
		<img {...main} alt="" loading="lazy" decoding="async" class="absolute inset-0 size-full object-cover" />
		<img
			{...alt}
			alt=""
			loading="lazy"
			decoding="async"
			class="absolute inset-0 size-full object-cover opacity-0 transition-opacity duration-400 ease-standard group-hover:opacity-100 group-focus-visible:opacity-100 motion-reduce:transition-none"
		/>
		<!-- Franja de tallas: sube desde abajo en hover/foco. Las agotadas van tachadas. -->
		<div
			class="absolute inset-x-0 bottom-0 flex translate-y-full items-center justify-between gap-4 bg-ground px-4 py-3 text-label font-stretch-110% uppercase transition-transform duration-400 ease-expo-out group-hover:translate-y-0 group-focus-visible:translate-y-0 motion-reduce:transition-none"
			aria-hidden="true"
		>
			<span>Tallas</span>
			<span class="flex gap-3">
				{SIZES.map((size) => <span class:list={[soldOut.includes(size) && 'line-through opacity-40']}>{size}</span>)}
			</span>
		</div>
	</div>
	<div class="mt-3 flex items-start justify-between gap-4 text-product-title">
		<h3>{title}</h3>
		<span>{price}</span>
	</div>
	<ProductTag class="mt-1">{category}</ProductTag>
	<span class="sr-only">Tallas disponibles: {available.join(', ')}</span>
</a>
