---
import { Picture } from 'astro:assets';
import { photos } from '../../data/photos';
import { categorySlug, SIZES, type Product } from '../../data/products';
import ProductTag from './ProductTag.astro';

interface Props {
	product: Product;
	wide?: boolean;
	href?: string;
	/** Aparición al hacer scroll; la vista filtrada la desactiva porque filtrar debe responder al instante. */
	reveal?: boolean;
	class?: string;
}

const { product, wide = false, href, reveal = true, class: className } = Astro.props;
const { title, price, category, ratio, photo, altPhoto, soldOut } = product;
// Sin página de producto todavía: la card filtra la tienda por su categoría (ver Shop.astro).
const slug = categorySlug(category);

const aspect = {
	'2/3': 'aspect-[2/3]',
	'3/4': 'aspect-[3/4]',
	'1/1': 'aspect-square',
	'4/5': 'aspect-[4/5]',
}[ratio];

const main = photos[photo];
const alt = photos[altPhoto];
const sizes = wide ? '(min-width: 1024px) 50vw, 100vw' : '(min-width: 1024px) 25vw, 50vw';
const available = SIZES.filter((size) => !soldOut.includes(size));
---

<a
	href={href ?? `?cat=${slug}#tienda`}
	class:list={['group block', className]}
	data-category={slug}
	data-filter={href ? undefined : slug}
	data-reveal={reveal || undefined}
>
	<div class:list={['relative overflow-hidden bg-surface-media', aspect]}>
		<Picture
			src={main.src}
			alt={main.alt}
			formats={['avif', 'webp']}
			widths={[400, 700, 1000]}
			sizes={sizes}
			class="absolute inset-0 size-full object-cover"
		/>
		<!-- La foto alternativa solo se ve con hover: va en un <template> (no se descarga) y el script la inserta en dispositivos con ratón. -->
		<template data-alt-photo>
			<Picture
				src={alt.src}
				alt=""
				formats={['avif', 'webp']}
				widths={[400, 700, 1000]}
				sizes={sizes}
				class="absolute inset-0 size-full object-cover opacity-0 transition-opacity duration-300 ease-standard group-hover:opacity-100 group-focus-visible:opacity-100 motion-reduce:transition-none"
			/>
		</template>
		<!-- Franja de tallas: sube desde abajo en hover/foco. Las agotadas van tachadas. -->
		<div
			class="absolute inset-x-0 bottom-0 flex translate-y-full items-center justify-between gap-4 bg-ground px-4 py-3 text-label font-stretch-110% uppercase transition-transform duration-300 ease-expo-out group-hover:translate-y-0 group-focus-visible:translate-y-0 motion-reduce:transition-none"
			aria-hidden="true"
		>
			<span>Tallas</span>
			<span class="flex gap-3">
				{SIZES.map((size) => <span class:list={[soldOut.includes(size) && 'line-through opacity-40']}>{size}</span>)}
			</span>
		</div>
	</div>
	<div class="mt-3 flex items-start justify-between gap-4 text-product-title">
		<h3>{title}</h3>
		<span class="tabular-nums">{price}</span>
	</div>
	<ProductTag class="mt-1">{category}</ProductTag>
	<span class="sr-only">Tallas disponibles: {available.join(', ')}</span>
</a>

<script>
	// Misma condición que el hover de Tailwind: en pantallas táctiles la foto alternativa nunca se vería.
	if (window.matchMedia('(hover: hover)').matches) {
		document.querySelectorAll<HTMLTemplateElement>('template[data-alt-photo]').forEach((template) => {
			template.replaceWith(template.content);
		});
	}
</script>
