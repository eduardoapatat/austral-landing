---
interface Props {
	rows: [string, string][];
	class?: string;
}

const { rows, class: className } = Astro.props;
---

<dl class:list={['border-t border-ink/30', className]}>
	{rows.map(([label, value]) => (
		<div class="flex items-baseline justify-between gap-6 border-b border-ink/30 py-4">
			<dt class="text-spec-label">{label}</dt>
			<dd class="text-right">{value}</dd>
		</div>
	))}
	<slot />
</dl>
