<!-- Cursor propio: solo con puntero fino y sin reduced-motion (lo activa el script). -->
<div class="group pointer-events-none fixed top-0 left-0 z-50 hidden opacity-0" aria-hidden="true" data-cursor-root>
	<div
		class="-mt-[50px] -ml-[50px] grid size-[100px] scale-[0.08] place-items-center rounded-full bg-ink transition-[scale,background-color] duration-200 ease-standard group-data-[state=view]:scale-100 group-data-[state=view]:bg-primary"
	>
		<span class="text-label text-on-primary uppercase opacity-0 transition-opacity duration-200 group-data-[state=view]:opacity-100">
			Ver más
		</span>
	</div>
</div>

<script>
	const root = document.querySelector<HTMLElement>('[data-cursor-root]');
	const fine = window.matchMedia('(hover: hover) and (pointer: fine)');
	const reduced = window.matchMedia('(prefers-reduced-motion: reduce)');

	if (root && fine.matches && !reduced.matches) {
		let x = 0;
		let y = 0;
		let frame = 0;

		root.classList.remove('hidden');
		document.documentElement.classList.add('has-cursor');

		window.addEventListener('pointermove', (event) => {
			x = event.clientX;
			y = event.clientY;
			root.classList.remove('opacity-0');
			if (!frame) {
				frame = requestAnimationFrame(() => {
					root.style.transform = `translate3d(${x}px, ${y}px, 0)`;
					frame = 0;
				});
			}
		});

		document.addEventListener('pointerover', (event) => {
			const target = event.target instanceof Element ? event.target.closest('[data-cursor="view"]') : null;
			root.dataset.state = target ? 'view' : '';
		});

		document.documentElement.addEventListener('pointerleave', () => root.classList.add('opacity-0'));
		document.documentElement.addEventListener('pointerenter', () => root.classList.remove('opacity-0'));
	}
</script>
