---
import Footer from '../components/layout/Footer.astro';
import Nav from '../components/layout/Nav.astro';
import EditorialGrid from '../components/sections/EditorialGrid.astro';
import HeroPhoto from '../components/sections/HeroPhoto.astro';
import Statement from '../components/sections/Statement.astro';
import SectionIndex from '../components/ui/SectionIndex.astro';
import { blocks } from '../data/products';
import Layout from '../layouts/Layout.astro';
---

<Layout title="ASTRO · Tienda editorial de prueba">
	<Nav />

	<main>
		<HeroPhoto photo="https://picsum.photos/id/1015/1600/1000" />
		<SectionIndex number="01" name="Colección" class="mx-(--gutter) mt-6" />

		<section id="tienda" class="flex flex-col gap-section px-(--gutter) pt-section" aria-label="Tienda">
			{blocks.map((items) => <EditorialGrid items={items} />)}
			<SectionIndex number="03" name="Tienda" />
		</section>

		<Statement lines={['Hecho para usarse.', 'O para mirarse.']}>
			Una tienda de prueba construida con el sistema ASTRO: una sola tinta, una rejilla de cuatro columnas y
			mucho espacio en blanco.
		</Statement>
	</main>

	<Footer />
</Layout>
