---
import Footer from '../components/layout/Footer.astro';
import Nav from '../components/layout/Nav.astro';
import CategoryIndex from '../components/sections/CategoryIndex.astro';
import ContactCta from '../components/sections/ContactCta.astro';
import FeaturedPiece from '../components/sections/FeaturedPiece.astro';
import HeroPhoto from '../components/sections/HeroPhoto.astro';
import Process from '../components/sections/Process.astro';
import Shop from '../components/sections/Shop.astro';
import SectionIndex from '../components/ui/SectionIndex.astro';
import { photos } from '../data/photos';
import Layout from '../layouts/Layout.astro';
---

<Layout title="AUSTRAL · Ropa de abrigo del sur de Chile">
	<Nav overHero />

	<main>
		<HeroPhoto photo={photos['hero-torres']} />
		<SectionIndex number="01" name="Colección" class="mx-(--gutter) mt-6" />

		<CategoryIndex />

		<Shop />

		<FeaturedPiece />

		<Process />
		<ContactCta email="hola@austral-ejemplo.cl" />
	</main>

	<Footer />
</Layout>
